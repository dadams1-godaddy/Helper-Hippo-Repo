{
  "display_information": {
    "name": "HelperHippo",
    "description": "Your friendly Slack assistant",
    "background_color": "#4a154b"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "HelperHippo",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/helperhippo",
        "description": "Introduce Helper Hippo and see what it can do",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/help",
        "description": "List all available commands and message triggers",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/weather",
        "description": "Get current weather (defaults to your Slack timezone)",
        "usage_hint": "[city or location]",
        "should_escape": false
      },
      {
        "command": "/joke",
        "description": "Get a random joke",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/ticket",
        "description": "Submit a support ticket with priority and category",
        "usage_hint": "[optional title to pre-fill]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "chat:write",
        "im:history",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.im"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
